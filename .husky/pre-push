bypass_value="${LITMATCH_CI_BYPASS:-${CI_BYPASS:-}}"
case "${bypass_value}" in
1|true|yes|on)
  echo "[husky] CI bypass enabled: skipping pre-push CI preflight"
  exit 0
  ;;
esac

# Pre-push can run without a real TTY (IDE, GUI Git client, or detached hook).
# Keep Nx's native terminal UI disabled at the outermost boundary as a defense in depth;
# ci-local and agent:verify also set this variable for their child processes.
export NX_TUI=false
export NX_DAEMON=false

pnpm ci:preflight
