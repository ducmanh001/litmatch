bypass_value="${LITMATCH_CI_BYPASS:-${CI_BYPASS:-}}"
case "${bypass_value}" in
1|true|yes|on)
  echo "[husky] CI bypass enabled: skipping pre-push CI preflight"
  exit 0
  ;;
esac

# Nx's native command runner may allocate a pseudo-terminal even with static output.
# Git hooks can have a TTY-shaped stdout without a usable controlling terminal.
export NX_NATIVE_COMMAND_RUNNER=false

pnpm ci:preflight
