NODE_ENV=production
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=https://litmatch-web.ACCOUNT.workers.dev,https://litmatch-admin.pages.dev
SWAGGER_ENABLED=false
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST:PORT
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_OTP_PEPPER=REPLACE_WITH_AT_LEAST_16_RANDOM_CHARACTERS
AUTH_GUEST_DEVICE_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_PHONE_OTP_ENABLED=true
AUTH_COOKIE_SAME_SITE=none
AUTH_GOOGLE_CLIENT_ID=
AUTH_APPLE_CLIENT_ID=
AUTH_FACEBOOK_APP_ID=
AUTH_FACEBOOK_APP_SECRET=
SENTRY_DSN=
SENTRY_RELEASE=
ANALYTICS_ENABLED=false
ANALYTICS_PROVIDER=disabled
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
ANALYTICS_HTTP_TIMEOUT_MS=5000
# Grafana Cloud OTLP traces: endpoint and Authorization header from Connections > OpenTelemetry.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# Grafana Cloud OpenTelemetry metrics (lấy từ Connections > OpenTelemetry; không phải /api/prom/push).
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USER=
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_API_TOKEN=
GRAFANA_CLOUD_METRICS_EXPORT_INTERVAL_MS=15000
ECONOMY_IAP_VERIFIER=disabled
ECONOMY_APPLE_WEBHOOK_VERIFIER=store
ECONOMY_GOOGLE_RTDN_VERIFIER=store
ECONOMY_OUTBOX_RELAY_ENABLED=false
ECONOMY_REFUND_POLL_ENABLED=false
MATCHING_GUEST_DAILY_LIMIT=3
MATCHING_GUEST_QUOTA_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MATCHING_MATCHER_INTERVAL_MS=10000
NOTIFICATION_PUSH_PROVIDER=disabled
NOTIFICATION_PUSH_HTTP_TIMEOUT_MS=5000
# Set the following only when the matching provider is enabled.
NOTIFICATION_FCM_PROJECT_ID=
NOTIFICATION_FCM_CLIENT_EMAIL=
NOTIFICATION_FCM_PRIVATE_KEY=
NOTIFICATION_APNS_TEAM_ID=
NOTIFICATION_APNS_KEY_ID=
NOTIFICATION_APNS_PRIVATE_KEY=
NOTIFICATION_APNS_BUNDLE_ID=
NOTIFICATION_APNS_ENVIRONMENT=production
WEB_PUSH_ENABLED=false
WEB_PUSH_SUBJECT=mailto:admin@example.com
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
VIDEO_UPLOAD_ENABLED=false
MEDIA_STORAGE_PROVIDER=r2
# AWS S3/MinIO profile (thay profile trên khi dùng):
# MEDIA_STORAGE_PROVIDER=s3
# AWS_REGION=ap-southeast-1
# AWS_S3_ENDPOINT=
# AWS_S3_BUCKET=litmatch-images
# AWS_ACCESS_KEY_ID=replace_with_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=replace_with_aws_secret_access_key
# AWS_S3_FORCE_PATH_STYLE=false
MEDIA_R2_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
MEDIA_R2_BUCKET=litmatch-images
MEDIA_R2_ACCESS_KEY_ID=REPLACE_WITH_CLOUDFLARE_R2_ACCESS_KEY_ID
MEDIA_R2_SECRET_ACCESS_KEY=REPLACE_WITH_CLOUDFLARE_R2_SECRET_ACCESS_KEY
MEDIA_PUBLIC_BASE_URL=https://images.example.com
MEDIA_UPLOAD_URL_TTL_SECONDS=900
MEDIA_IMAGE_MAX_BYTES=10485760
MEDIA_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
LIVEKIT_URL=wss://PROJECT.livekit.cloud
LIVEKIT_API_URL=https://PROJECT.livekit.cloud
LIVEKIT_API_KEY=REPLACE_FROM_LIVEKIT_CLOUD
LIVEKIT_API_SECRET=REPLACE_FROM_LIVEKIT_CLOUD
