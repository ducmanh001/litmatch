# Public host. Tạo A record app/admin/api/realtime/media cùng trỏ về PUBLIC_IP.
DOMAIN=example.com
PUBLIC_IP=203.0.113.10
ACME_EMAIL=owner@example.com

# Google OAuth Web client dùng chung cho app + admin. Đây là client id công khai, không phải secret.
GOOGLE_OAUTH_CLIENT_ID=replace-me.apps.googleusercontent.com
# Facebook App ID is public; App Secret remains server-only in this protected host env.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Database password chỉ dùng A-Z/a-z/0-9/_/- để release script encode thống nhất vào DATABASE_URL.
POSTGRES_USER=litmatch
POSTGRES_PASSWORD=replace_with_random_url_safe_password
POSTGRES_DB=litmatch
POSTGRES_HOST_PORT=5432

# Tạo bằng: openssl rand -base64 48 (không commit file .env thật).
JWT_SECRET=replace_with_at_least_32_characters # gitleaks:allow
AUTH_OTP_PEPPER=replace_with_at_least_16_characters # gitleaks:allow
LIVEKIT_API_KEY=replace_with_random_key
LIVEKIT_API_SECRET=replace_with_at_least_32_characters # gitleaks:allow

# --- image uploads ---
MEDIA_STORAGE_PROVIDER=r2
MEDIA_R2_ACCOUNT_ID=replace_with_cloudflare_account_id
MEDIA_R2_BUCKET=litmatch-images
MEDIA_R2_ACCESS_KEY_ID=replace_with_cloudflare_r2_access_key_id
MEDIA_R2_SECRET_ACCESS_KEY=replace_with_cloudflare_r2_secret_access_key
MEDIA_PUBLIC_BASE_URL=https://images.example.com
MEDIA_UPLOAD_URL_TTL_SECONDS=900
MEDIA_IMAGE_MAX_BYTES=10485760
MEDIA_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif

# Optional PostHog Cloud Free; để trống cả hai thì analytics tắt.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# Production observability bắt buộc và có DRI. Không dùng tên team chung; ghi người/on-call
# rotation đang chịu trách nhiệm cho alert delivery của release này.
OBSERVABILITY_OWNER=replace_with_accountable_dri

# Grafana Cloud bắt buộc. App metrics dùng OTLP endpoint; Alloy dùng cho LiveKit/logs.
# GRAFANA_CLOUD_PROMETHEUS_URL lấy từ Connections > OpenTelemetry (/otlp), không phải /api/prom/push.
GRAFANA_CLOUD_PROMETHEUS_URL=replace_with_grafana_otlp_metrics_url
GRAFANA_CLOUD_PROMETHEUS_USER=replace_with_metrics_user
GRAFANA_CLOUD_METRICS_EXPORT_INTERVAL_MS=15000
GRAFANA_CLOUD_LOKI_URL=replace_with_loki_push_url
GRAFANA_CLOUD_LOKI_USER=replace_with_loki_user
GRAFANA_CLOUD_API_TOKEN=replace_with_scoped_write_token

# OTel traces bắt buộc. Header không được commit giá trị thật.
OTEL_EXPORTER_OTLP_ENDPOINT=replace_with_otlp_trace_endpoint
OTEL_EXPORTER_OTLP_HEADERS=replace_with_otlp_authorization_header

# Sentry bắt buộc cho cả bốn app production; DSN là public ingest identifier.
SENTRY_CORE_API_DSN=https://replace@sentry.invalid/1
SENTRY_SIGNALING_DSN=https://replace@sentry.invalid/2
NEXT_PUBLIC_SENTRY_DSN=https://replace@sentry.invalid/3
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_RELEASE=
VITE_SENTRY_DSN=https://replace@sentry.invalid/4
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=
SENTRY_RELEASE=
